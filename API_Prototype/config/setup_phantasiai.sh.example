#!/bin/bash

# CONFIGURATION
USER_NAME=$(whoami)
HOME_DIR="/home/$USER_NAME"
APP_DIR="$HOME_DIR/PhantasiAI/API_Prototype"
SSID_NAME="[ACCESS_POINT]"

echo "Starting PhantasiAI Environment Setup..."

# 1. Install Dependencies
sudo apt update && sudo apt install -y libnotify-bin mako-notifier python3-tk network-manager lsof

# 2. Create the error notification script
cat <<EOF > "$HOME_DIR/notify_fail.sh"
#!/bin/bash
USER_ID=\$(id -u $USER_NAME)
sudo -u $USER_NAME DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$USER_ID/bus \\
notify-send "PhantasiAI Error" "Failure in backend server setup" --icon=error --urgency=critical
EOF
chmod +x "$HOME_DIR/notify_fail.sh"

# 3: Create systemd services
sudo bash -c "cat <<EOF > /etc/systemd/system/phantasiai_backend.service
[Unit]
Description=PhantasiAI Backend
Wants=network-online.target
After=network-online.target
OnFailure=phantasiai_error.service

[Service]
User=$USER_NAME
Group=$USER_NAME
WorkingDirectory=$APP_DIR
ExecStart=/bin/bash $APP_DIR/dev.sh
Restart=always
RestartSec=10
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
EOF"

sudo bash -c "cat <<EOF > /etc/systemd/system/phantasiai_error.service
[Unit]
Description=Notify user of failure
[Service]
Type=oneshot
ExecStart=$HOME_DIR/notify_fail.sh
EOF"

# OPTIONAL: Comment out if using local host 
# 4: Set network priority (Assumes network was already joined once)
sudo nmcli connection modify "$SSID_NAME" connection.autoconnect-priority 100 2>/dev/null || echo "Network $SSID_NAME not found yet; connect manually later."

# 5: Add custom shortcuts to .bashrc
if ! grep -q "phrestart" "$HOME_DIR/.bashrc"; then
    cat <<EOF >> "$HOME_DIR/.bashrc"
# PhantasiAI Aliases
alias phstop='sudo systemctl stop phantasiai_backend.service'
alias phrestart='sudo systemctl restart phantasiai_backend.service'
alias phlogs='sudo journalctl -u phantasiai_backend.service -f'
alias phstatus='sudo systemctl status phantasiai_backend.service'
EOF
fi

# 6: Sudoers permissions (No password for restart/reboot)
SUDOERS_FILE="/etc/sudoers.d/phantasiai"
sudo bash -c "echo '$USER_NAME ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart phantasiai_backend.service, /usr/sbin/reboot' > $SUDOERS_FILE"
sudo chmod 440 $SUDOERS_FILE

# 7: Enable services
sudo systemctl daemon-reload
sudo systemctl enable phantasiai_backend.service

echo "Setup Complete! Please reboot to apply all changes."